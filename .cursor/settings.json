{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.exclude": {
    "**/.next": true,
    "**/.next/**": true,
    "**/.next-locked-*": true,
    "**/.next-locked-*/**": true,
    "**/out": true,
    "**/out/**": true,
    "**/node_modules": true,
    "**/node_modules/**": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.next-locked-*/**": true,
    "**/out/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/.next/**": true,
    "**/.next-locked-*": true,
    "**/.next-locked-*/**": true,
    "**/out": true,
    "**/out/**": true,
    "**/node_modules": true,
    "**/node_modules/**": true
  },
  "plugins": {
    "supabase": {
      "enabled": true
    }
  }
}
