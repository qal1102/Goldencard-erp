# GoldenCard ERP — environment template
# Copy to `.env.local` for local development. Never commit real secrets.
#
# Production (Vercel): set variables in Project → Settings → Environment Variables
# Domain: https://goldencard.cloud

# -----------------------------------------------------------------------------
# Database (PostgreSQL — typically Supabase)
# -----------------------------------------------------------------------------

# Runtime connection used by the Next.js app (src/db/index.ts).
# On Vercel/serverless: prefer Supabase *Transaction pooler* (port 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Direct connection for Drizzle CLI only (migrate, push, studio, seed, create-admin).
# Not required for Vercel runtime builds/deploys unless you run migrations in CI.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres

# -----------------------------------------------------------------------------
# Auth (Auth.js / next-auth v5)
# -----------------------------------------------------------------------------

# Required in production. Generate: openssl rand -base64 32
AUTH_SECRET=

# Canonical site URL for Auth.js callbacks (custom domain on Vercel).
AUTH_URL=https://goldencard.cloud

# Trust reverse proxy host on Vercel (recommended with custom domain).
AUTH_TRUST_HOST=true

# Legacy NextAuth v4 names — optional if AUTH_* above are set
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://goldencard.cloud

# -----------------------------------------------------------------------------
# Public app URL (embedded in client bundle)
# -----------------------------------------------------------------------------

# Used for warranty QR / public check links when rendered on the server.
# Should match production domain (no trailing slash).
NEXT_PUBLIC_APP_URL=https://goldencard.cloud

# -----------------------------------------------------------------------------
# Not used by this codebase (no @supabase/supabase-js client)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
